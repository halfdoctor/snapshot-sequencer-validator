                "summary": "Get epoch lifecycle tracking",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Epoch ID to track",
                        "name": "epochID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Protocol state identifier (defaults to configured protocol)",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address (defaults to configured market)",
                        "name": "market",
                        "in": "query"
                    }
