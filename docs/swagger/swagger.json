{
    "swagger": "2.0",
    "info": {
        "description": "Monitoring API that reads pre-aggregated data from state-tracker worker",
        "title": "DSV Pipeline Monitor API (Direct Redis)",
        "contact": {},
        "version": "3.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/aggregation/results": {
            "get": {
                "description": "Get network-wide aggregated batches with validator contributions",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "aggregation"
                ],
                "summary": "Aggregation results",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Protocol state identifier",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address",
                        "name": "market",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of results (default 20)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.FinalizedBatch"
                            }
                        }
                    }
                }
            }
        },
        "/batches/finalized": {
            "get": {
                "description": "Get Level 1 (local) or Level 2 (aggregated) finalized batches. Queries last 24 hours of data (matches retention period).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "batches"
                ],
                "summary": "Finalized batches",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Protocol state identifier",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address",
                        "name": "market",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Batch level (1 or 2, default both)",
                        "name": "level",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Specific epoch ID",
                        "name": "epoch_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of batches to retrieve (default 50, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.FinalizedBatch"
                            }
                        }
                    }
                }
            }
        },
        "/dashboard/summary": {
            "get": {
                "description": "Get pre-aggregated dashboard metrics from state-tracker",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard"
                ],
                "summary": "Dashboard summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.DashboardSummary"
                        }
                    }
                }
            }
        },
        "/epochs/active": {
            "get": {
                "description": "Get epochs currently in progress (window open, level 1/2 in progress). Queries epoch state directly for accuracy.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "epochs"
                ],
                "summary": "Active epochs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Protocol state identifier",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address",
                        "name": "market",
                        "in": "query"
