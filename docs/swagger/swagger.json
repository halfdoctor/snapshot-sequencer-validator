                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.EnhancedTimelineResponse"
                        }
                    }
                }
            }
        },
        "/vpa/epoch/{epochID}": {
            "get": {
                "description": "Get priority assignment and submission status for a specific epoch. Returns combined priority and submission information including priority details and submission details if available.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vpa"
                ],
                "summary": "Get VPA status for specific epoch",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Epoch ID",
                        "name": "epochID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Protocol state identifier (defaults to configured protocol)",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address (defaults to configured market)",
                        "name": "market",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "VPA epoch status with priority and submission information",
                        "schema": {
                            "$ref": "#/definitions/main.VPAEpochStatusResponse"
                        }
                    },
                    "404": {
                        "description": "Epoch not found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/vpa/epoch/{epochID}/lifecycle": {
            "get": {
                "description": "Track complete lifecycle of an epoch from release to submission, showing all stages and timing",
