                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.EpochInfo"
                            }
                        }
                    }
                }
            }
        },
        "/epochs/gaps": {
            "get": {
                "description": "Identify epochs that should have finalizations but don't",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "epochs"
                ],
                "summary": "Epoch gaps",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Protocol state identifier",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data market address",
                        "name": "market",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Window minutes to check for gaps (default 5)",
                        "name": "window_minutes",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                }
            }
        },
        "/epochs/timeline": {
            "get": {
                "description": "Get epoch progression with phases and batch status",
